# Copy to .env and choose one backend. Never commit .env.
# OpenRouter is the default when CS329Z_LLM_BACKEND is not set.
CS329Z_LLM_BACKEND=openrouter
OPENROUTER_API_KEY=

# Copilot Bridge: set CS329Z_LLM_BACKEND=copilot_bridge and uncomment these.
# The bridge handles upstream authentication; this key is a non-secret placeholder.
# CS329Z_BRIDGE_BASE_URL=http://127.0.0.1:8765/codex
# CS329Z_BRIDGE_API_KEY=local-bridge
# CS329Z_GRADING_MODEL=gpt-6-luna
# CS329Z_USER_MODEL=gpt-6-luna
# CS329Z_JUDGE_MODEL=gpt-6-sol
# CS329Z_CACHE_DIR=.lm_cache/copilot-bridge
# To switch back, restore openrouter and remove the three model overrides
# and cache override above. OPENROUTER_API_KEY is unused in bridge mode.

# Optional overrides
# CS329Z_GRADING_MODEL=openai/gpt-6-luna  # OpenRouter model ID; grading uses the default
# CS329Z_REASONING_EFFORT=low # reasoning effort for models that accept it
# CS329Z_BUDGET_USD=25        # your own stop: the LM wrapper refuses new calls once the ledger reaches this
# CS329Z_EVAL_SLICE=5         # run live tests on the first N items only
